# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly enforce LF for shell scripts, python, markdown, and config
*.sh text eol=lf
*.py text eol=lf
*.scm text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
