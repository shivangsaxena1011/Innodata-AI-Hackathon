# ==============================================================================
# CodeForge AI - Environment Configuration
# Team TECH TITAN (Shivang Saxena, Rani Malviya)
# ==============================================================================

# Model Provider API Keys
# LiteLLM automatically picks up keys according to the selected model provider:
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# CodeForge Settings (Pydantic Settings prefixed with CODEFORGE_)
# Default model (e.g. Gemini free-tier or local Ollama)
# CODEFORGE_MODEL=gemini/gemini-flash-latest
# CODEFORGE_TEMPERATURE=0.2
# CODEFORGE_MAX_OUTPUT_TOKENS=16000
# CODEFORGE_LLM_TIMEOUT_SEC=240
# CODEFORGE_LLM_CACHE=true

# Sandbox & Container execution
# CODEFORGE_DOCKER_BIN=docker
# CODEFORGE_CONTAINER_MEMORY=2g
# CODEFORGE_CONTAINER_CPUS=2
# CODEFORGE_TEST_TIMEOUT_SEC=600
# CODEFORGE_BUILD_TIMEOUT_SEC=900

# Generation & Validation thresholds
# CODEFORGE_SEED=1337
# CODEFORGE_CANDIDATES_PER_ROUND=6
# CODEFORGE_MAX_REPAIR_ATTEMPTS=2
# CODEFORGE_MAX_MUTANTS=30
# CODEFORGE_MIN_MUTATION_SCORE=0.6
# CODEFORGE_BASELINE_RUNS=3
# CODEFORGE_NOVELTY_THRESHOLD=0.55
# CODEFORGE_HARBOR_ORG=codeforge
